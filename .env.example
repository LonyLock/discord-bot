# ============================================================
#  Discord Bot — Environment Configuration
#  Copy this file to ".env" and fill in your values.
# ============================================================

# REQUIRED — Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# REQUIRED — Your application's Client ID (Application ID)
CLIENT_ID=your-application-client-id

# OPTIONAL — A test guild (server) ID. If set, slash commands are
# registered instantly to this guild only (great for development).
# Leave blank to register commands globally (can take up to 1 hour).
GUILD_ID=

# OPTIONAL — Comma-separated list of user IDs who are bot owners.
# Owners bypass permission checks and can use developer commands.
OWNER_IDS=

# OPTIONAL — Default command prefix for legacy (message based) commands.
# This can be overridden per-server with /config prefix.
DEFAULT_PREFIX=!

# OPTIONAL — Node environment.
NODE_ENV=production

# ============================================================
#  WEB DASHBOARD (optional)
#  A browser UI to configure the bot per-server with Discord login.
# ============================================================

# Set to "true" to start the dashboard alongside the bot.
DASHBOARD_ENABLED=false

# Your OAuth2 Client Secret (Developer Portal -> OAuth2 -> Reset Secret).
# Required only when the dashboard is enabled.
CLIENT_SECRET=your-oauth2-client-secret

# Public base URL of the dashboard (no trailing slash).
# In the Developer Portal -> OAuth2, add "<DASHBOARD_URL>/callback" as a redirect.
DASHBOARD_URL=http://localhost:3000

# Port the dashboard listens on.
DASHBOARD_PORT=3000

# A long random string used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
