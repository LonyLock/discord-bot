<%- include('partials/header', { title: guild.name + ' Leaderboards' }) %>

<div class="manage-head">
  <% if (guild.icon) { %><img src="<%= guild.icon %>" alt="" class="manage-icon" /><% } %>
  <div><h1><%= guild.name %> — Leaderboards</h1></div>
  <a href="/servers/<%= guild.id %>" class="btn btn-secondary btn-sm">Settings</a>
</div>

<div class="lb-grid">
  <div class="card">
    <h2>📈 Top Levels</h2>
    <% if (!levels.length) { %><p class="muted">No data yet.</p><% } else { %>
      <ol class="lb-list">
        <% levels.forEach((l, i) => { %>
          <li><span class="lb-rank">#<%= i + 1 %></span><span class="lb-name"><%= l.name %></span><span class="lb-val">Lvl <%= l.level %> &middot; <%= l.total_xp.toLocaleString() %> XP</span></li>
        <% }) %>
      </ol>
    <% } %>
  </div>

  <div class="card">
    <h2>🪙 Richest</h2>
    <% if (!economy.length) { %><p class="muted">No data yet.</p><% } else { %>
      <ol class="lb-list">
        <% economy.forEach((e, i) => { %>
          <li><span class="lb-rank">#<%= i + 1 %></span><span class="lb-name"><%= e.name %></span><span class="lb-val"><%= currency %> <%= e.total.toLocaleString() %></span></li>
        <% }) %>
      </ol>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
