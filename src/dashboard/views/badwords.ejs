<%- include('partials/header', { title: guild.name + ' — Bad Words' }) %>
<%- include('partials/managenav', { guild, active }) %>

<div class="card">
  <h2>🚫 Bad-Words Filter</h2>
  <p class="muted">Messages containing these words are auto-deleted when the <strong>Bad-Words</strong> automod filter is enabled (Settings → Auto-Moderation). Members with <em>Manage Messages</em> are exempt.</p>
  <form method="POST" action="/servers/<%= guild.id %>/badwords" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>" />
    <input type="hidden" name="_action" value="add" />
    <input class="input" type="text" name="word" placeholder="word or comma,separated,list" maxlength="500" required />
    <button type="submit" class="btn btn-primary">Add</button>
  </form>
</div>

<div class="card">
  <h2>Blocked words <span class="badge"><%= words.length %></span></h2>
  <% if (!words.length) { %>
    <p class="muted">No words blocked yet.</p>
  <% } else { %>
    <div class="chip-list">
      <% words.forEach((w) => { %>
        <form method="POST" action="/servers/<%= guild.id %>/badwords" class="chip">
          <input type="hidden" name="_csrf" value="<%= csrf %>" />
          <input type="hidden" name="_action" value="remove" />
          <input type="hidden" name="word" value="<%= w %>" />
          <span><%= w %></span>
          <button type="submit" class="chip-x" title="Remove">✕</button>
        </form>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
