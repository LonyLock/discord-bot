<%- include('partials/header', { title: 'Analytics' }) %>

<%- include('partials/ownernav', { active }) %>

<div class="stats-row">
  <div class="stat-card"><span class="stat-num"><%= totals.servers.toLocaleString() %></span><span class="stat-label">Servers</span></div>
  <div class="stat-card"><span class="stat-num"><%= totals.members.toLocaleString() %></span><span class="stat-label">Members</span></div>
  <div class="stat-card"><span class="stat-num"><%= totals.actions.toLocaleString() %></span><span class="stat-label">Mod actions</span></div>
  <div class="stat-card"><span class="stat-num"><%= totals.actions7.toLocaleString() %></span><span class="stat-label">Actions (7d)</span></div>
</div>

<div class="card">
  <h2>🌐 Servers</h2>
  <% if (!servers.length) { %>
    <p class="muted">The bot isn't in any servers yet.</p>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th>Server</th><th>Members</th><th>Mod actions</th><th>Warns</th><th>Economy</th><th>Leveling</th></tr></thead>
      <tbody>
        <% servers.forEach((s) => { %>
          <tr>
            <td><%= s.name %></td>
            <td><%= s.members.toLocaleString() %></td>
            <td><strong><%= s.modActions %></strong></td>
            <td><%= s.warnings %></td>
            <td><%= s.econUsers %></td>
            <td><%= s.levelUsers %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="lb-grid">
  <div class="card">
    <h2>🛡️ Top Moderators <span class="muted">(all servers)</span></h2>
    <% if (!moderators.length) { %>
      <p class="muted">No moderation actions recorded yet.</p>
    <% } else { %>
      <table class="data-table">
        <thead><tr><th>#</th><th>Moderator</th><th>Actions</th><th>Breakdown</th></tr></thead>
        <tbody>
          <% moderators.forEach((m, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= m.name %></td>
              <td><strong><%= m.total %></strong></td>
              <td><% Object.entries(m.actions).sort((a, b) => b[1] - a[1]).forEach(([a, c]) => { %><span class="badge"><%= a %> <%= c %></span> <% }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="card">
    <h2>📊 Actions by type</h2>
    <% if (!byAction.length) { %>
      <p class="muted">No data yet.</p>
    <% } else { const max = byAction[0].c; %>
      <% byAction.forEach((a) => { %>
        <div class="abar-row">
          <span class="abar-label"><%= a.action %></span>
          <div class="abar"><span style="width: <%= Math.round((a.c / max) * 100) %>%"></span></div>
          <span class="abar-val"><%= a.c %></span>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
